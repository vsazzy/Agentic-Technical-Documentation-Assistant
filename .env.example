# Slack Socket Mode credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token
SLACK_SIGNING_SECRET=your-signing-secret

# Only this channel may add, list, or remove PDFs.
RAG_MANAGEMENT_CHANNEL_ID=C0123456789

# Optional comma-separated channel IDs for documentation questions. Empty allows all.
ALLOWED_CHANNELS=
SLACK_RESPONSE_TYPE=in_channel

# Fully local model/runtime settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
VISION_MODEL=qwen2.5vl:7b
MAX_PDF_BYTES=209715200
MAX_PDF_PAGES=2000
